# Web app configuration (copy to apps/web/.env.local).
# Name used in the greeting until Google login exists.
NEXT_PUBLIC_DEFAULT_USER_NAME=
# Only set this to call a deployed API directly; by default /api is proxied to the local Python service.
NEXT_PUBLIC_LAYOUT_API_URL=
# Optional: where the dev proxy forwards /api (default http://127.0.0.1:8000).
QUANTARIS_API_ORIGIN=
# Browser key for the Google Maps JavaScript API (restrict by HTTP referrer). Without it the sourcing map uses OpenStreetMap tiles.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
