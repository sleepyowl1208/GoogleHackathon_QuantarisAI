# QuantarisAI configuration. Copy this file to `.env.local` (repo root) and fill in the values.
# `.env.local` is gitignored. Never paste real keys into chat, commits or screenshots.

# --- Gemini (AI) --- REQUIRED for the chat to work
# Today: a Gemini Developer API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Google Cloud (not needed yet; fill in when the project exists) ---
# Vertex AI instead of an API key: run `gcloud auth application-default login`, then set these two.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1

# --- Google login (Identity Platform / Firebase Auth) ---
GOOGLE_OAUTH_CLIENT_ID=

# --- Google Maps Platform ---
# Server key (restrict by IP): turns on Google Geocoding and Google Places (real addresses for existing mills) automatically.
# Until it is set, geocoding uses OpenStreetMap Nominatim and live weather uses Open-Meteo, both free and keyless.
GOOGLE_MAPS_SERVER_KEY=
# Optional contact string sent to OpenStreetMap's geocoder, as its usage policy asks.
GEOCODER_USER_AGENT=

# --- Cloud Translation (more Indian languages beyond English and Hindi) ---
GOOGLE_TRANSLATE_PROJECT=

# --- Storage and data (Firestore for saved chats, Cloud Storage for uploads, BigQuery for datasets) ---
FIRESTORE_DATABASE=(default)
GCS_UPLOAD_BUCKET=
BIGQUERY_DATASET=

# --- Planned operational-data backbone (NOT used by the code yet; the AI operations tab runs on simulated data) ---
# Names only. Sensor streams -> Pub/Sub -> Dataflow -> BigQuery; images and exports in Cloud Storage; forecasting on Vertex AI.
QUANTARIS_BQ_DATASET=
QUANTARIS_PUBSUB_TOPIC=
QUANTARIS_GCS_BUCKET=
